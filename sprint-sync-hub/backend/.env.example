# Slack
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_CHANNEL_ID=Cxxxxxxxxxx
SLACK_SIGNING_SECRET=your-signing-secret

# Jira
JIRA_EMAIL=admin@yourcompany.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_SITE_URL=https://yourcompany.atlassian.net
JIRA_CLOUD_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
JIRA_PROJECT_KEY=QG
# Find board ID: open your Jira board → look at the URL → .../boards/NUMBER
JIRA_BOARD_ID=your_board_id_here

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Sprint
SPRINT_NAME=Sprint 1
SPRINT_START_DATE=2026-05-18
SPRINT_DURATION_WEEKS=2

# Schedule
TIMEZONE=Asia/Kolkata
EOD_CHECK_TIME=17:30
REPORT_DAY=Friday
REPORT_TIME=17:00
MANAGER_SLACK_ID=

# Team Lead (receives private mismatch alerts and management notifications via DM)
# Get your Slack user ID: Slack → your profile → ⋯ → Copy member ID
TEAM_LEAD_SLACK_ID=U0XXXXXXXXX

# Team Members (JSON array string)
TEAM_MEMBERS=[{"id":"U000000001","name":"Alice","initials":"AL"},{"id":"U000000002","name":"Bob","initials":"BO"}]

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/sprint_sync_hub

# Zoho People (optional — enables attendance-aware standup reminders)
# Register at: accounts.zoho.in/developerconsole → Add Client → Server-based Application
# Scopes: ZOHOPEOPLE.attendance.READ ZOHOPEOPLE.leave.READ ZOHOPEOPLE.employee.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Your Zoho company slug — visible in your People URL: people.zoho.in/{slug}/
# Used in API paths. Not a numeric ID.
ZOHO_ORG_IDENTIFIER=
# Region: zoho.in (India) | zoho.com (US) | zoho.eu (EU)
# OAuth endpoint:  accounts.{ZOHO_DOMAIN}
# API endpoint:    www.zohoapis.{tld}  (e.g. www.zohoapis.in for zoho.in)
ZOHO_DOMAIN=zoho.in
WORK_START_TIME=09:00
WORK_END_TIME=18:00
# LATE_GRACE_MINUTES: minutes after WORK_START_TIME before marking as late (default 15)
LATE_GRACE_MINUTES=15

# Checkout Detection (used by cron Job 5 — polls Zoho for checkouts Mon-Fri 4:30-7:30pm)
CHECKOUT_POLL_START=16:30
CHECKOUT_POLL_END=19:30
# Name of the standup Slack channel (used in DM copy). Include or omit the #.
SLACK_CHANNEL_NAME=tech-huddle

# Encryption key for secrets stored in DB (AES-256-GCM)
# Must be exactly 32 ASCII characters OR 64 hex characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If not set, a dev-only fallback key is used (NOT safe for production).
ENCRYPTION_KEY=

# Organisation
ORGANISATION_ID=1
ORGANISATION_NAME=My Company
